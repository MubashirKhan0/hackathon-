<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    Perception Systems Diagram
  </text>
  <circle cx="200" cy="150" r="70" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="145" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Camera</text>
  <text x="200" y="165" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Vision</text>
  <circle cx="400" cy="150" r="70" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="400" y="145" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">LIDAR</text>
  <text x="400" y="165" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Range</text>
  <circle cx="600" cy="150" r="70" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="600" y="145" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">IMU</text>
  <text x="600" y="165" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Inertial</text>
  <text x="400" y="280" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Perception Systems: Multi-sensor Integration</text>
</svg>