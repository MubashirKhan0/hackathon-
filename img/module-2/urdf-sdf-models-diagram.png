<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    URDF/SDF Models Diagram
  </text>
  <rect x="150" y="100" width="200" height="200" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="250" y="200" font-family="Arial" font-size="14" text-anchor="middle" fill="#0066cc">URDF Model</text>
  <rect x="450" y="100" width="200" height="200" fill="#ffe6e6" stroke="#cc0000" stroke-width="2"/>
  <text x="550" y="200" font-family="Arial" font-size="14" text-anchor="middle" fill="#cc0000">SDF Model</text>
  <text x="400" y="320" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">URDF vs SDF: Robot Description Formats</text>
</svg>