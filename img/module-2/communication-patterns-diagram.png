<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    Communication Patterns Diagram
  </text>
  <rect x="100" y="100" width="200" height="80" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="145" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Publisher</text>
  <rect x="500" y="100" width="200" height="80" fill="#ffe6e6" stroke="#cc0000" stroke-width="2"/>
  <text x="600" y="145" font-family="Arial" font-size="12" text-anchor="middle" fill="#cc0000">Subscriber</text>
  <line x1="300" y1="140" x2="500" y2="140" stroke="#666" stroke-width="2" marker-end="url(#arrowhead)"/>
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7"
      refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#666"/>
    </marker>
  </defs>
  <text x="400" y="250" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Communication Pattern: Publisher-Subscriber Model</text>
</svg>