<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    VLA Systems Diagram
  </text>
  <rect x="100" y="100" width="200" height="60" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="135" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Level 1: Manual</text>
  <rect x="100" y="180" width="200" height="60" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="215" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Level 2: Assisted</text>
  <rect x="100" y="260" width="200" height="60" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="295" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Level 3: Automated</text>
  <rect x="500" y="180" width="200" height="60" fill="#ffe6e6" stroke="#cc0000" stroke-width="2"/>
  <text x="600" y="215" font-family="Arial" font-size="12" text-anchor="middle" fill="#cc0000">VLA System</text>
  <text x="400" y="60" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Variable Level of Autonomy: From Manual to Full Automation</text>
</svg>