<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    Digital AI to Physical AI Concept
  </text>
  <rect x="50" y="100" width="300" height="200" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="200" font-family="Arial" font-size="16" text-anchor="middle" fill="#0066cc">Digital AI</text>
  <rect x="450" y="100" width="300" height="200" fill="#ffe6e6" stroke="#cc0000" stroke-width="2"/>
  <text x="600" y="200" font-family="Arial" font-size="16" text-anchor="middle" fill="#cc0000">Physical AI</text>
  <text x="400" y="250" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Transition from Digital to Physical Intelligence</text>
</svg>