<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    Embodied Intelligence Diagram
  </text>
  <circle cx="200" cy="150" r="60" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="155" font-family="Arial" font-size="14" text-anchor="middle" fill="#0066cc">Body</text>
  <circle cx="600" cy="150" r="60" fill="#ffe6e6" stroke="#cc0000" stroke-width="2"/>
  <text x="600" y="155" font-family="Arial" font-size="14" text-anchor="middle" fill="#cc0000">Mind</text>
  <line x1="260" y1="150" x2="540" y2="150" stroke="#666" stroke-width="2" stroke-dasharray="5,5"/>
  <text x="400" y="120" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Embodied Intelligence: Body-Mind Integration</text>
</svg>