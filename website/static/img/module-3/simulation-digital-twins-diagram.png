<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    Simulation & Digital Twins Diagram
  </text>
  <rect x="100" y="100" width="250" height="200" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="225" y="150" font-family="Arial" font-size="14" text-anchor="middle" fill="#0066cc">Physical</text>
  <text x="225" y="180" font-family="Arial" font-size="14" text-anchor="middle" fill="#0066cc">Robot</text>
  <rect x="450" y="100" width="250" height="200" fill="#ffe6e6" stroke="#cc0000" stroke-width="2"/>
  <text x="575" y="150" font-family="Arial" font-size="14" text-anchor="middle" fill="#cc0000">Digital</text>
  <text x="575" y="180" font-family="Arial" font-size="14" text-anchor="middle" fill="#cc0000">Twin</text>
  <line x1="350" y1="200" x2="450" y2="200" stroke="#666" stroke-width="2" stroke-dasharray="5,5"/>
  <text x="400" y="250" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Physical Robot ↔ Digital Twin</text>
</svg>