<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <rect width="800" height="400" fill="#f0f8ff"/>
  <text x="400" y="200" font-family="Arial" font-size="24" text-anchor="middle" fill="#333">
    Integration & Coordination Diagram
  </text>
  <circle cx="200" cy="150" r="50" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="200" y="155" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Robot A</text>
  <circle cx="400" cy="150" r="50" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="400" y="155" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Robot B</text>
  <circle cx="600" cy="150" r="50" fill="#e6f3ff" stroke="#0066cc" stroke-width="2"/>
  <text x="600" y="155" font-family="Arial" font-size="12" text-anchor="middle" fill="#0066cc">Robot C</text>
  <line x1="250" y1="150" x2="350" y2="150" stroke="#666" stroke-width="2" stroke-dasharray="5,5"/>
  <line x1="450" y1="150" x2="550" y2="150" stroke="#666" stroke-width="2" stroke-dasharray="5,5"/>
  <text x="400" y="250" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Multi-Robot Integration and Coordination</text>
</svg>