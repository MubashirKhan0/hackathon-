  <circle cx="200" cy="200" r="30" fill="#ffcc99" stroke="#cc6600" stroke-width="2"/>
  <text x="200" y="205" font-family="Arial" font-size="12" text-anchor="middle" fill="#cc6600">Head</text>
  <circle cx="400" cy="180" r="40" fill="#ffcc99" stroke="#cc6600" stroke-width="2"/>
  <text x="400" y="185" font-family="Arial" font-size="12" text-anchor="middle" fill="#cc6600">Torso</text>
  <text x="400" y="250" font-family="Arial" font-size="14" text-anchor="middle" fill="#666">Humanoid Robot Architecture: Human-like Form Factor</text>
